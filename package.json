{
  "name": "gantt-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @gantt/demo dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "generate": "node --experimental-strip-types packages/mock/src/cli.ts",
    "verify": "pnpm run check:boundaries && pnpm run typecheck && pnpm test && pnpm run e2e",
    "bench": "node scripts/bench.mjs",
    "e2e": "node scripts/e2e.mjs",
    "docs:api": "node scripts/api-docs.mjs",
    "lint": "eslint --max-warnings=0 ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
